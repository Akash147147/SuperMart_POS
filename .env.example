# SuperMart POS Configuration
# Copy this file to .env and update values

# Flask
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=supermart_pos
DB_USER=root
DB_PASSWORD=your_mysql_password

# Supermarket defaults
DEFAULT_STORE_NAME=SuperMart
DEFAULT_CURRENCY=INR
DEFAULT_TAX_TYPE=intra-state

# Server
HOST=127.0.0.1
PORT=5000

